# pyenv
#   For a library or app, you might want to share your .python-version.
#   Comment this line out if you want to share it.
.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in git.
#   However, in case of collaboration, if you want to keep your own dependencies,
#   pipenv or poetry might be used, in which case you might ignore it.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock is generally tracked in version control.
#   However, in case of collaboration, you might want to ignore it.
#poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock is generally tracked in version control.
#pdm.lock
.pdm-plugins/
.pdm-python/

# uv
.uv-cache/

# PEP 582; used by e.g. pdm when initialized with `pdm init`
